class Solution:
    def merge(self, s1, s2):
        # code here
        res = ''
        i = j = 0
        while i<len(s1) and j<len(s2):
            res += s1[i]
            res+=s2[j]
            i+=1
            j+=1
        while i <len(s1):
            res+=s1[i]
            i+=1
        while j < len(s2):
            res += s2[j]
            j+=1
        
        return res

