class Solution:
    def binarySubstring(self, s):
        # 1. Count the total number of '1's in the string
        n = s.count('1')

        # 2. Calculate pairs using the combination formula (nC2)
        # Using integer division '//' to return a whole number
        return (n * (n - 1)) // 2
        
        
        
        
