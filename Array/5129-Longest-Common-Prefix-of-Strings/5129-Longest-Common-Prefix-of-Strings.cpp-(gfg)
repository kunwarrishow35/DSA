class Solution:
    def longestCommonPrefix(self, arr):
        # code here
        arr.sort()
        res = ''
        i = 0
        first = arr[0]
        last = arr[-1]
        while i < len(first) and i < len(last):
            if first[i]==last[i]:
                res+=first[i]
                i+=1
            else:
                break
                
        return res
            
            
            