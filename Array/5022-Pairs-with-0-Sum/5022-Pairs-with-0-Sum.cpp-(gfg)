class Solution:
    def getPairs(self, arr):
        arr.sort()

        l = 0
        r = len(arr) - 1
        result = []

        while l < r:
            total = arr[l] + arr[r]

            if total == 0:
                result.append([arr[l], arr[r]])

                left = arr[l]
                right = arr[r]

 
                while l < r and arr[l] == left:
                    l += 1

                while l < r and arr[r] == right:
                    r -= 1

            elif total < 0:
                l += 1

            else:
                r -= 1

        return result