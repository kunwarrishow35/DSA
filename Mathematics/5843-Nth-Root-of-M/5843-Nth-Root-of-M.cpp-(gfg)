class Solution:
    
    def power(self, x, y):
        result = 1
        for i in range(y):
            result *= x
        return result
            
        
        
    def nthRoot(self, n, m):
       # code here
        left = 0
        right = m
        
        
        while left<=right:
            mid = left + (right - left) // 2
            power1 = self.power(mid, n)
            if power1 == m:
                return mid
            elif power1<m:
                left = mid+1
            else:
                right = mid-1
               
            
        return -1
       
