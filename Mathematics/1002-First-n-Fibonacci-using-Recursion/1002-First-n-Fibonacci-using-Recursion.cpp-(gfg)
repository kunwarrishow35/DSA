class Solution:
    def fibonacciNumbers(self, n: int) -> list[int]:
        # code here
        result = [0, 1]
        if n == 1:
            return [0]
        elif n==2:
            return result
        else:
            for i in range(2, n):
                result.append(result[i-1]+result[i-2])
                
        return result
                
            