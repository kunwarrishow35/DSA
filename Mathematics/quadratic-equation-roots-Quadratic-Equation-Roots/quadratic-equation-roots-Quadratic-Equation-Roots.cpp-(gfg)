#include <stdlib.h>
#include <math.h>

int* quadraticRoots(int a, int b, int c, int* retSize) {
    int d = b * b - 4 * a * c;

    if (d < 0) {
        *retSize = 1;

        int *roots = malloc(sizeof(int));
        roots[0] = -1;

        return roots;
    }

    int *roots = malloc(2 * sizeof(int));

    roots[0] = floor((-b + sqrt(d)) / (2.0 * a));
    roots[1] = floor((-b - sqrt(d)) / (2.0 * a));

    if (roots[0] < roots[1]) {
        int temp = roots[0];
        roots[0] = roots[1];
        roots[1] = temp;
    }

    *retSize = 2;

    return roots;
}